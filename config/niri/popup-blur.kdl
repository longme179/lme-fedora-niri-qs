// Optional: niri >= 26.04. Merge/include only on a supported niri build.
// The shell requests blur for glass surfaces and optional full-screen popup overlays.
// xray=false includes application windows in the blur, rather than wallpaper only.
// Non-xray effects are experimental in niri and may disappear during
// window open/close animations or while dragging tiled windows.
layer-rule {
    match namespace="^lme-(bar|overlay|authentication|desktop|notifications|osd)$"
    background-effect {
        xray false
    }
}
window-rule {
    match app-id="^lme-shell-settings$"
    // Keep niri's focus-ring backing from filling the transparent window.
    draw-border-with-background false
    background-effect {
        xray false
    }
}
// Start with a moderate budget for the integrated Radeon.
// This block affects all compositor blur; merge with an existing blur block.
blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.0
}
