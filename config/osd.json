    "osdMargin": {
      "type": "integer",
      "validator": "integer",
      "portable": true,
      "appearance": false,
      "default": 24,
      "min": 0,
      "max": 96
    },
    "osdOutput": {
      "type": "string",
      "validator": "osdOutput",
      "portable": false,
      "appearance": false,
      "default": "focused"
    }
  }
}
