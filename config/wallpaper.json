{
  "id": "wallpaper",
  "sources": [
    "qml/settings/WallpaperPlaylistSettings.qml",
    "qml/settings/AwwwSettings.qml",
    "scripts/wallpaper.py",
    "scripts/wallpaper_actions.py",
    "scripts/wallpaper_palette.py",
    "scripts/palette_actions.py"
  ],
  "settingsPage": {
    "key": "wallpaper",
    "title": "Wallpaper",
    "icon": "applications",
    "description": "A backdrop that feels like you",
    "keywords": "playlist shuffle pause interval transition display output background image picture folder library thumbnail matugen material scheme contrast palette light dark",
    "entry": "qml/settings/WallpaperPage.qml",
    "after": "desktop"
  },
  "preferences": {
    "wallpaper": {
      "type": "string",
      "validator": "legacy",
      "portable": false,
      "appearance": false,
      "default": ""
    },
    "wallpaperFolder": {
      "type": "string",
      "validator": "legacy",
      "portable": false,
      "appearance": false,
      "default": ""
    },
    "wallpaperPlaylist": {
      "type": "array",
      "validator": "legacy",
      "portable": false,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPlaylistEnabled": {
      "type": "boolean",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPlaylistPaused": {
      "type": "boolean",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPlaylistShuffle": {
      "type": "boolean",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPlaylistInterval": {
      "type": "integer",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPlaylistOutput": {
      "type": "string",
      "validator": "legacy",
      "portable": false,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransition": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionDuration": {
      "type": "number",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperOutputs": {
      "type": "object",
      "validator": "legacy",
      "portable": false,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionFps": {
      "type": "integer",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
