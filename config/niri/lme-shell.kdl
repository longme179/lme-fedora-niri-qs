// LME Shell integration fragment. Do not replace your niri configuration.
// Requires niri >= 25.11 for overview and stable-ID window movement.
// Remove existing binds with these same keys before merging this fragment.

spawn-sh-at-startup "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/lme-shell/scripts/start.sh\""
// The shell includes a Polkit password popup. Keep only one session agent;
// remove a previous authentication-agent autostart entry when switching.

// Keep the independent settings application at its requested window size.
window-rule {
    match title="^(LME Shell Settings( - Demo)?|LME Screenshot)$"
    open-floating true
}

binds {
    Mod+Shift+A hotkey-overlay-title="Activity island" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "activity";
    }
    Mod+V hotkey-overlay-title="Clipboard history" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "clipboard";
    }
    Mod+Tab hotkey-overlay-title="Window overview" { toggle-overview; }
    Mod+Shift+Tab hotkey-overlay-title="Workspace board" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "overview";
    }
    Mod+Space hotkey-overlay-title="Open application launcher" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "launcher";
    }
    Mod+A hotkey-overlay-title="Open control center" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "control";
    }
    Mod+N hotkey-overlay-title="Open notifications" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "notifications";
    }
    Mod+Comma hotkey-overlay-title="Open shell settings" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "settings";
    }
    Mod+Shift+E hotkey-overlay-title="Open power menu" {
        spawn "quickshell" "-c" "lme-shell" "ipc" "call" "shell" "toggle" "power";
    }
}
