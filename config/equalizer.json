{
  "id": "equalizer",
  "sources": [
    "qml/settings/EqualizerPage.qml",
    "qml/panels/EqualizerPanel.qml",
    "qml/services/EqualizerState.qml",
    "qml/components/SegmentSwitch.qml",
    "qml/components/EqualizerBands.qml",
    "qml/components/EqualizerPresets.qml",
    "qml/components/EqualizerBalance.qml",
    "qml/components/EqualizerAudioControls.qml",
    "scripts/equalizer_actions.py"
  ],
  "settingsPage": {
    "key": "equalizer",
    "title": "Equalizer",
    "icon": "audio",
    "description": "Serpantinum equalizer and dynamics for PipeWire audio",
    "keywords": "equalizer bands eq balance mono swap dynamics compressor limiter bypass serpantinum",
    "entry": "qml/settings/EqualizerPage.qml",
    "after": "utilities"
  },
  "preferences": {
    "equalizerEnabled": {
      "type": "boolean",
      "validator": "boolean",
      "portable": true,
      "appearance": false,
      "default": false
    }
  },
  "backend": {
    "entry": "scripts/equalizer_actions.py",
    "factory": "provide"
  },
  "panel": {
    "id": "equalizer",
    "entry": "qml/panels/EqualizerPanel.qml",
    "centered": true,
    "scrim": 0.4
  },
  "bar": {
    "id": "equalizer",
    "title": "Equalizer",
    "detail": "Serpantinum equalizer bands and dynamics",
    "icon": "audio",
    "entry": "qml/bar/EqualizerButton.qml",
    "after": "audio"
  }
}
