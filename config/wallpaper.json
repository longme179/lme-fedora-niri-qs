    "wallpaperTransitionStep": {
      "type": "integer",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionAngle": {
      "type": "integer",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionPosition": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionBezier": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperTransitionWave": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperResize": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperFilter": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperFillColor": {
      "type": "string",
      "validator": "legacy",
      "portable": true,
      "appearance": false,
      "defaultResolver": "wallpaper"
    },
    "wallpaperPalette": {
      "type": "object",
      "validator": "legacy",
      "portable": true,
      "appearance": true,
      "defaultResolver": "palette"
    }
