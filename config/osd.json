{
  "id": "osd",
  "preferences": {
    "osdEnabled": {
      "type": "boolean",
      "validator": "boolean",
      "portable": true,
      "appearance": false,
      "default": true
    },
    "osdPosition": {
      "type": "string",
      "validator": "osdPosition",
      "portable": true,
      "appearance": false,
      "default": "bottom-center"
    },
    "osdLayout": {
      "type": "string",
      "validator": "osdLayout",
      "portable": true,
      "appearance": false,
      "default": "horizontal"
